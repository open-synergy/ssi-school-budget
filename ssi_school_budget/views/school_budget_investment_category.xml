<odoo>
<record id="school_budget_investment_category_view_search" model="ir.ui.view">
    <field name="name">school_budget_investment_category - search</field>
    <field name="model">school_budget_investment_category</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="school_budget_investment_category_view_tree" model="ir.ui.view">
    <field name="name">school_budget_investment_category - tree</field>
    <field name="model">school_budget_investment_category</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="before">
                <field name="sequence" widget="handle" />
            </xpath>
            <xpath expr="//field[@name='code']" position="after">
                <field name="default_economic_life" />
                <field name="account_id" optional="show" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_budget_investment_category_view_form" model="ir.ui.view">
    <field name="name">school_budget_investment_category - form</field>
    <field name="model">school_budget_investment_category</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <field name="sequence" />
                <field name="default_economic_life" />
                <field name="account_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_budget_investment_category_action" model="ir.actions.act_window">
    <field name="name">Investment Categories</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_budget_investment_category</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_budget_investment_category_menu"
        name="Investment Categories"
        parent="menu_school_budget_configuration"
        action="school_budget_investment_category_action"
        groups="school_budget_investment_category_group"
        sequence="30"
    />

</odoo>
