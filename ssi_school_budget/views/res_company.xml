<odoo>
<record id="view_company_form_school_budget" model="ir.ui.view">
    <field name="name">res.company form - school budget analytic account</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//sheet" position="inside">
                <group name="school_budget_analytic" string="School Budget">
                    <field name="school_analytic_account_id" />
                    <field name="school_analytic_group_id" />
                </group>
            </xpath>
        </data>
    </field>
</record>
</odoo>
