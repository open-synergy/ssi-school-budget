<odoo>
<record id="policy_template_school_budget" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_school_budget" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','school_budget'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- Confirm -->
<record id="policy_template_school_budget_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_budget_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Done (automatic via after-approved, kept for policy field consistency) -->
<record id="policy_template_school_budget_done" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','done_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_budget_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Cancel -->
<record id="policy_template_school_budget_cancel" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','in',['draft','confirm','reject'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_budget_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Restart -->
<record id="policy_template_school_budget_restart" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','restart_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','in',['cancel','reject'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('school_budget_validator_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- Reject -->
<record id="policy_template_school_budget_reject" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Approve -->
<record id="policy_template_school_budget_approve" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','school_budget'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<!-- Manual Number -->
<record id="policy_template_school_budget_manual_number" model="policy.template_detail">
    <field name="template_id" ref="policy_template_school_budget" />
    <field
            name="field_id"
            search="[('model_id.model','=','school_budget'),('name','=','manual_number_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
