#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__include_parent_allocation
msgid ""
"When enabled (default), costs and depreciation pushed down from ancestor "
"(branch/center) budgets are included in this unit's UP/US cost base. When "
"disabled, every allocated component is treated as zero."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_contribution_allocation__is_pct_up_overridden
msgid ""
"When enabled, Override UP Percentage is used as pct_up instead of the "
"automatically computed proportion. Substitute for the reference "
"application's 'None = automatic' semantics: an override of 0.0 is a valid "
"value."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__is_up_rate_overridden
msgid ""
"When enabled, Override UP Rate is used as the final UP tariff instead of the"
" automatically computed rate. This boolean is the substitute for the "
"reference application's 'None = automatic' semantics: an override value of "
"zero is only honored when this box is checked."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_contribution_allocation__is_pct_us_overridden
msgid ""
"When enabled, Override US Percentage is used as pct_us instead of the "
"automatically computed proportion."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__is_us_rate_overridden
msgid ""
"When enabled, Override US Rate is used as the final US tariff instead of the"
" automatically computed rate. This boolean is the substitute for the "
"reference application's 'None = automatic' semantics: an override value of "
"zero is only honored when this box is checked."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_category__is_up_component
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_line__is_up_component
msgid ""
"When enabled, expense lines under this category are included in the UP (Uang"
" Pangkal) cost base used by the tariff simulation engine."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_category__is_direct_income
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_line__is_direct_income
msgid ""
"When enabled, expense lines under this category automatically generate a "
"matching income line (based on the foundation-funded amount) booked under "
"'Maps to Income Category'."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_category__is_operational
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_line__is_operational
msgid ""
"When enabled, this category represents an operational expense (e.g. account "
"range 5110-5250). When disabled, it is a non-operational expense (e.g. "
"account range 5500-5590)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_parent_expense_allocation__affects_up
msgid ""
"When enabled, this cost category is pushed down into the children's UP base "
"(split by new students). Otherwise it goes into the US base (split by total "
"students)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__dep_per_year
msgid "acquisition_cost / useful_life."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_up_revenue
msgid "auto_up_rate * new_student_count."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_us_revenue
msgid "auto_us_rate * total_student_count * 12."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_comparison__variance
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_income_comparison__variance
msgid "budget_amount - realized_amount."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__dep_current_year
msgid "dep_per_year * (13 - start_month) / 12, start_month clamped to 1..12."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__dep_current_year
msgid ""
"dep_per_year if the asset is still within its useful life this fiscal year, "
"otherwise 0."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_revenue
msgid "final_up_rate * new_student_count."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_us_revenue
msgid "final_us_rate * total_student_count * 12."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__book_value
msgid "max(0, acquisition_cost - dep_per_year * years elapsed)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__ending_cash_balance
msgid "opening_cash_balance + cash_surplus_deficit."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__final_up_rate
msgid ""
"override_up_rate as-is when Override UP Rate is enabled, otherwise "
"auto_up_rate."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__final_us_rate
msgid ""
"override_us_rate as-is when Override US Rate is enabled, otherwise "
"auto_us_rate."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__end_book_value
msgid "purchase_price - dep_current_year."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__dep_per_year
msgid "purchase_price / useful_life (0 when useful_life <= 0)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_income_comparison__absorption_rate
msgid ""
"realized_amount / budget_amount * 100. 0 when budget_amount is 0 (guarded "
"against division by zero)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_comparison__absorption_rate
msgid ""
"realized_amount / budget_amount * 100. 0 when budget_amount is 0 (guarded "
"against division by zero). Values above 100 are valid (over-budget)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_accrual_expense
msgid ""
"total_cash_expense + total_depreciation (own assets only; accrual accounting"
" expenses depreciation instead of the investment purchase)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__cash_surplus_deficit
msgid ""
"total_cash_revenue - total_cash_expense - total_investment (cash accounting "
"expenses the full investment purchase)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_depreciation
msgid "total_new_investment_dep + total_old_asset_dep."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_cost
msgid "total_own_up_cost + allocated_up_branch + allocated_up_center."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_us_cost
msgid ""
"total_own_us_cost + allocated_us_branch + allocated_us_center. Never "
"includes depreciation."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_investment
msgid "total_physical_investment + total_financial_investment."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__expense_absorption_rate
msgid ""
"total_realized_expense / total budgeted expense * 100. 0 when the budgeted "
"total is 0 (guarded against division by zero)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_cost_with_dep
msgid ""
"total_up_cost + total_up_dep + allocated financial investments from branch "
"and center. This is the UP tariff divisor's numerator."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_up_rate
msgid ""
"total_up_cost_with_dep / new_student_count (guarded: 0 students is treated "
"as 1)."
msgstr ""

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_us_rate
msgid ""
"total_us_cost / (total_student_count * 12), guarded: 0 students is treated "
"as 1."
msgstr ""
