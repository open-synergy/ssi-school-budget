#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_line__is_direct_income
msgid "When enabled, expense lines under this category automatically generate a matching income line (based on the foundation-funded amount) booked under 'Maps to Income Category'."
msgstr "Bila diaktifkan, baris biaya pada kategori ini otomatis membuat baris pendapatan yang sesuai (berdasarkan jumlah yang didanai yayasan) yang dibukukan pada 'Dipetakan ke Kategori Pendapatan'."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_category__is_operational
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_line__is_operational
msgid "When enabled, this category represents an operational expense (e.g. account range 5110-5250). When disabled, it is a non-operational expense (e.g. account range 5500-5590)."
msgstr "Bila diaktifkan, kategori ini mewakili biaya operasional (mis. rentang akun 5110-5250). Bila dinonaktifkan, kategori ini adalah biaya non operasional (mis. rentang akun 5500-5590)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_parent_expense_allocation__affects_up
msgid "When enabled, this cost category is pushed down into the children's UP base (split by new students). Otherwise it goes into the US base (split by total students)."
msgstr "Bila diaktifkan, kategori biaya ini didorong ke basis UP anak (dibagi menurut siswa baru). Jika tidak, masuk ke basis US (dibagi menurut total siswa)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__dep_per_year
msgid "acquisition_cost / useful_life."
msgstr "acquisition_cost / useful_life."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_up_revenue
msgid "auto_up_rate * new_student_count."
msgstr "auto_up_rate * new_student_count."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_us_revenue
msgid "auto_us_rate * total_student_count * 12."
msgstr "auto_us_rate * total_student_count * 12."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_comparison__variance
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_income_comparison__variance
msgid "budget_amount - realized_amount."
msgstr "budget_amount - realized_amount."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__dep_current_year
msgid "dep_per_year * (13 - start_month) / 12, start_month clamped to 1..12."
msgstr "dep_per_year * (13 - start_month) / 12, start_month dibatasi ke 1..12."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__dep_current_year
msgid "dep_per_year if the asset is still within its useful life this fiscal year, otherwise 0."
msgstr "dep_per_year bila aset masih dalam masa manfaatnya pada tahun fiskal ini, jika tidak 0."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_revenue
msgid "final_up_rate * new_student_count."
msgstr "final_up_rate * new_student_count."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_us_revenue
msgid "final_us_rate * total_student_count * 12."
msgstr "final_us_rate * total_student_count * 12."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_old_asset__book_value
msgid "max(0, acquisition_cost - dep_per_year * years elapsed)."
msgstr "max(0, acquisition_cost - dep_per_year * tahun yang telah berlalu)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__ending_cash_balance
msgid "opening_cash_balance + cash_surplus_deficit."
msgstr "opening_cash_balance + cash_surplus_deficit."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__final_up_rate
msgid "override_up_rate as-is when Override UP Rate is enabled, otherwise auto_up_rate."
msgstr "override_up_rate apa adanya bila Ganti Tarif UP diaktifkan, jika tidak auto_up_rate."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__final_us_rate
msgid "override_us_rate as-is when Override US Rate is enabled, otherwise auto_us_rate."
msgstr "override_us_rate apa adanya bila Ganti Tarif US diaktifkan, jika tidak auto_us_rate."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__end_book_value
msgid "purchase_price - dep_current_year."
msgstr "purchase_price - dep_current_year."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_investment__dep_per_year
msgid "purchase_price / useful_life (0 when useful_life <= 0)."
msgstr "purchase_price / useful_life (0 bila useful_life <= 0)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_income_comparison__absorption_rate
msgid "realized_amount / budget_amount * 100. 0 when budget_amount is 0 (guarded against division by zero)."
msgstr "realized_amount / budget_amount * 100. 0 bila budget_amount adalah 0 (dijaga dari pembagian dengan nol)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget_expense_comparison__absorption_rate
msgid "realized_amount / budget_amount * 100. 0 when budget_amount is 0 (guarded against division by zero). Values above 100 are valid (over-budget)."
msgstr "realized_amount / budget_amount * 100. 0 bila budget_amount adalah 0 (dijaga dari pembagian dengan nol). Nilai di atas 100 adalah sah (melebihi anggaran)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_accrual_expense
msgid "total_cash_expense + total_depreciation (own assets only; accrual accounting expenses depreciation instead of the investment purchase)."
msgstr "total_cash_expense + total_depreciation (hanya aset sendiri; akuntansi akrual membebankan penyusutan sebagai pengganti pembelian investasi)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__cash_surplus_deficit
msgid "total_cash_revenue - total_cash_expense - total_investment (cash accounting expenses the full investment purchase)."
msgstr "total_cash_revenue - total_cash_expense - total_investment (akuntansi kas membebankan seluruh pembelian investasi)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_depreciation
msgid "total_new_investment_dep + total_old_asset_dep."
msgstr "total_new_investment_dep + total_old_asset_dep."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_cost
msgid "total_own_up_cost + allocated_up_branch + allocated_up_center."
msgstr "total_own_up_cost + allocated_up_branch + allocated_up_center."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_us_cost
msgid "total_own_us_cost + allocated_us_branch + allocated_us_center. Never includes depreciation."
msgstr "total_own_us_cost + allocated_us_branch + allocated_us_center. Tidak pernah menyertakan penyusutan."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_investment
msgid "total_physical_investment + total_financial_investment."
msgstr "total_physical_investment + total_financial_investment."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__expense_absorption_rate
msgid "total_realized_expense / total budgeted expense * 100. 0 when the budgeted total is 0 (guarded against division by zero)."
msgstr "total_realized_expense / total biaya yang dianggarkan * 100. 0 bila total yang dianggarkan adalah 0 (dijaga dari pembagian dengan nol)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__total_up_cost_with_dep
msgid "total_up_cost + total_up_dep + allocated financial investments from branch and center. This is the UP tariff divisor's numerator."
msgstr "total_up_cost + total_up_dep + investasi keuangan yang dialokasikan dari cabang dan pusat. Ini adalah pembilang pembagi tarif UP."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_up_rate
msgid "total_up_cost_with_dep / new_student_count (guarded: 0 students is treated as 1)."
msgstr "total_up_cost_with_dep / new_student_count (dijaga: 0 siswa dianggap 1)."

#. module: ssi_school_budget
#: model:ir.model.fields,help:ssi_school_budget.field_school_budget__auto_us_rate
msgid "total_us_cost / (total_student_count * 12), guarded: 0 students is treated as 1."
msgstr "total_us_cost / (total_student_count * 12), dijaga: 0 siswa dianggap 1."
